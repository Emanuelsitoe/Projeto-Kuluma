<!-- ============ HERO ============ -->
<section class="mx-auto w-full max-w-6xl px-4 pb-16 pt-12 sm:px-6 sm:pt-16 lg:px-8 lg:pt-20" aria-labelledby="heroTitle">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
    <div class="min-w-0">
      <p class="mono-tag mb-4 inline-flex items-center gap-2 rounded-full border border-edge bg-surf px-3 py-1.5 text-sky2"><i data-lucide="scan-search" class="h-3.5 w-3.5"></i>AI-POWERED THREAT INTELLIGENCE</p>
      <h1 id="heroTitle" class="text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-5xl lg:text-[3.4rem]">Before You Trust It, Verify It.</h1>
      <p class="mt-5 max-w-xl text-base text-mute sm:text-lg">Detect suspicious threats, fake authority claims, money demands, and fraudulent warnings with AI-assisted security analysis.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#analyze" class="btn btn-primary">Analyze a Message</a>
        <a href="#how" class="btn btn-ghost">Learn How It Works</a>
      </div>
      <p class="mt-5 max-w-xl text-sm text-mute">Pause before you respond. Inspect suspicious messages for warning signs without sharing your passwords or payment credentials.</p>
      <ul class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <li class="flex items-start gap-2.5 rounded-xl border border-edge bg-surf/70 p-3"><i data-lucide="file-audio" class="mt-0.5 h-5 w-5 shrink-0 text-mint"></i><span class="text-sm">Text and audio analysis</span></li>
        <li class="flex items-start gap-2.5 rounded-xl border border-edge bg-surf/70 p-3"><i data-lucide="quote" class="mt-0.5 h-5 w-5 shrink-0 text-sky2"></i><span class="text-sm">Evidence-backed explanations</span></li>
        <li class="flex items-start gap-2.5 rounded-xl border border-edge bg-surf/70 p-3"><i data-lucide="list-checks" class="mt-0.5 h-5 w-5 shrink-0 text-ultra"></i><span class="text-sm">Practical next steps</span></li>
      </ul>
    </div>

    <!-- Demo preview (static, clearly labeled) -->
    <div class="min-w-0" role="img" aria-label="Demo preview of the threat analysis dashboard. Illustrative content, not a live analysis.">
      <div class="card relative overflow-hidden p-4 shadow-2xl shadow-sky2/5 sm:p-5">
        <div class="scanline" style="--h:420px"></div>
        <div class="relative flex flex-wrap items-center justify-between gap-2">
          <span class="mono-tag rounded-md border border-warn/40 bg-warn/10 px-2 py-1 text-warn">DEMO PREVIEW — illustrative content, not a live analysis.</span>
          <span class="mono-tag flex items-center gap-1.5 text-mute"><span class="pulse-dot h-1.5 w-1.5 rounded-full bg-sky2"></span>decorative activity</span>
        </div>

        <div class="relative mt-4 rounded-xl border border-edge bg-ink/70 p-3.5">
          <p class="mono-tag mb-2 text-mute">Sample message</p>
          <p class="break-words text-sm leading-7">
            “BANK ALERT: Your account is
            <mark class="rounded bg-danger/20 px-1 text-txt underline decoration-danger decoration-2 underline-offset-4">suspended<sup class="ml-0.5 font-mono text-[0.65rem]">[1]</sup></mark>.
            Verify now at
            <mark class="rounded bg-warn/20 px-1 text-txt underline decoration-warn decoration-2 underline-offset-4">sample-link.example/secure<sup class="ml-0.5 font-mono text-[0.65rem]">[2]</sup></mark>
            or face
            <mark class="rounded bg-danger/20 px-1 text-txt underline decoration-danger decoration-2 underline-offset-4">legal action within 2 hours<sup class="ml-0.5 font-mono text-[0.65rem]">[3]</sup></mark>.”
          </p>
        </div>

        <div class="relative mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-danger/40 bg-danger/10 p-3.5">
            <p class="mono-tag text-mute">Risk level (demo)</p>
            <p class="mt-1 flex items-center gap-2 text-lg font-bold text-danger"><i data-lucide="octagon-alert" class="h-5 w-5"></i>High</p>
            <p class="mt-1 text-xs text-mute">Sample value only.</p>
          </div>
          <ul class="min-w-0 space-y-1.5 rounded-xl border border-edge bg-ink/70 p-3.5 text-xs">
            <li class="flex items-center justify-between gap-2"><span class="min-w-0 truncate">Fake authority</span><span class="shrink-0 text-warn">Detected</span></li>
            <li class="flex items-center justify-between gap-2"><span class="min-w-0 truncate">Threats</span><span class="shrink-0 text-danger">Detected</span></li>
            <li class="flex items-center justify-between gap-2"><span class="min-w-0 truncate">Money demand</span><span class="shrink-0 text-mute">Inconclusive</span></li>
            <li class="flex items-center justify-between gap-2"><span class="min-w-0 truncate">Fraudulent warning</span><span class="shrink-0 text-danger">Detected</span></li>
            <li class="flex items-center justify-between gap-2"><span class="min-w-0 truncate">Link / credentials</span><span class="shrink-0 text-warn">Detected</span></li>
          </ul>
        </div>

        <ol class="relative mt-3 space-y-2 rounded-xl border border-edge bg-ink/70 p-3.5 text-xs text-mute">
          <li><span class="font-mono text-txt">[1]</span> Urgent account-status claim without context.</li>
          <li><span class="font-mono text-txt">[2]</span> Login requested through a message-supplied link.</li>
          <li><span class="font-mono text-txt">[3]</span> Time-limited legal threat to force a quick reply.</li>
        </ol>
      </div>
    </div>
  </div>
</section>

<!-- ============ HOW IT WORKS ============ -->
<section id="how" class="mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 lg:px-8" aria-labelledby="howTitle">
  <h2 id="howTitle" class="text-2xl font-bold tracking-tight sm:text-3xl">How it works</h2>
  <p class="mt-2 max-w-2xl text-mute">Three steps from a suspicious message to a safer decision.</p>
  <ol class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
    <li class="card min-w-0 p-5">
      <div class="flex items-center gap-3"><span class="grid h-11 w-11 place-items-center rounded-xl bg-mint/10 text-mint"><i data-lucide="upload" class="h-5 w-5"></i></span><span class="mono-tag text-mute">Step 01</span></div>
      <h3 class="mt-4 text-lg font-semibold">Submit</h3>
      <p class="mt-1.5 text-sm text-mute">Paste a suspicious message or upload an MP3 recording.</p>
    </li>
    <li class="card min-w-0 p-5">
      <div class="flex items-center gap-3"><span class="grid h-11 w-11 place-items-center rounded-xl bg-sky2/10 text-sky2"><i data-lucide="cpu" class="h-5 w-5"></i></span><span class="mono-tag text-mute">Step 02</span></div>
      <h3 class="mt-4 text-lg font-semibold">Analyze</h3>
      <p class="mt-1.5 text-sm text-mute">AI examines the available content for suspicious language, impersonation, threats, money demands, fraudulent warnings, and risky links.</p>
    </li>
    <li class="card min-w-0 p-5">
      <div class="flex items-center gap-3"><span class="grid h-11 w-11 place-items-center rounded-xl bg-ultra/10 text-ultra"><i data-lucide="shield-check" class="h-5 w-5"></i></span><span class="mono-tag text-mute">Step 03</span></div>
      <h3 class="mt-4 text-lg font-semibold">Act safely</h3>
      <p class="mt-1.5 text-sm text-mute">Review the evidence, understand the risk assessment, and follow practical recommendations.</p>
    </li>
  </ol>
  <p class="mt-6 flex items-start gap-2.5 rounded-xl border border-edge bg-surf/70 p-4 text-sm text-mute"><i data-lucide="info" class="mt-0.5 h-4 w-4 shrink-0 text-sky2"></i><span>ScamShield AI assesses message content. It does not independently verify the sender’s identity or prove whether a message is fraudulent.</span></p>
</section>

<!-- ============ WORKSPACE ============ -->
<section id="analyze" class="mx-auto w-full max-w-4xl px-4 py-16 sm:px-6 lg:px-8" aria-labelledby="workTitle">
  <h2 id="workTitle" class="sr-only">Analysis workspace</h2>
  <div class="flex flex-col gap-6">

    <!-- Card 1: Input -->
    <section class="card p-5 sm:p-6" aria-labelledby="inputTitle">
      <h3 id="inputTitle" class="text-xl font-bold tracking-tight">Input Message</h3>
      <p class="mt-1 text-sm text-mute">Submit suspicious text or an audio recording for AI-assisted analysis.</p>

      <div class="mt-5 grid grid-cols-2 gap-1 rounded-xl border border-edge bg-ink p-1" role="tablist" aria-label="Input mode">
        <button id="tabText" type="button" role="tab" aria-selected="true" aria-controls="panelText" class="btn !min-h-[44px] !rounded-lg !px-2 text-sm"><i data-lucide="message-square-text" class="h-4 w-4 shrink-0"></i>Text Input</button>
        <button id="tabAudio" type="button" role="tab" aria-selected="false" aria-controls="panelAudio" tabindex="-1" class="btn !min-h-[44px] !rounded-lg !px-2 text-sm"><i data-lucide="file-audio" class="h-4 w-4 shrink-0"></i>MP3 Recording</button>
      </div>
      <p id="modeNote" class="mono-tag mt-2 text-mute">Active mode: Text Input. Switching modes keeps what you entered, but only the active mode is analyzed.</p>

      <!-- Text panel -->
      <div id="panelText" role="tabpanel" aria-labelledby="tabText" class="mt-4">
        <label for="msg" class="mb-1.5 block text-sm font-medium">Message to analyze</label>
        <textarea id="msg" rows="9" class="field min-h-[200px] resize-y leading-relaxed" placeholder="Paste a suspicious SMS, email, warning, or conversation here..." aria-describedby="msgCount msgErr msgPrivacy"></textarea>
        <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
          <p id="msgCount" class="mono-tag text-mute" aria-live="off">0 / 20,000</p>
          <button id="clearText" type="button" class="btn btn-ghost !min-h-[40px] !px-3 !py-1.5 text-sm"><i data-lucide="eraser" class="h-4 w-4"></i>Clear text</button>
        </div>
        <p id="msgErr" class="mt-2 hidden text-sm text-danger" role="alert"></p>
        <p id="msgPrivacy" class="mt-3 flex items-start gap-2.5 rounded-xl border border-edge bg-ink/60 p-3 text-xs text-mute"><i data-lucide="lock" class="mt-0.5 h-4 w-4 shrink-0 text-sky2"></i><span>Do not include passwords, one-time authentication codes, full payment credentials, or other sensitive secrets. Your message is processed for analysis; avoid submitting information you do not need analyzed. Submitted content is sent to Groq, the AI provider, and is subject to its policies.</span></p>
      </div>

      <!-- Audio panel -->
      <div id="panelAudio" role="tabpanel" aria-labelledby="tabAudio" class="mt-4 hidden">
        <input id="fileInput" type="file" accept=".mp3,audio/mpeg,audio/mp3" class="sr-only" tabindex="-1" aria-hidden="true">
        <button id="dropZone" type="button" class="flex min-h-[170px] w-full flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-edge bg-ink/60 p-6 text-center transition-colors hover:border-sky2" aria-describedby="fileHelp fileErr">
          <i data-lucide="upload" class="h-8 w-8 text-sky2"></i>
          <span class="font-semibold">Choose an MP3 or drag it here</span>
          <span id="fileHelp" class="text-xs text-mute">MP3 only, up to 25 MB.</span>
        </button>
        <p id="fileErr" class="mt-2 hidden text-sm text-danger" role="alert"></p>

        <div id="recPanel" class="mt-4 hidden rounded-2xl border border-danger/40 bg-danger/10 p-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <p class="flex items-center gap-2 font-semibold text-danger"><span class="pulse-dot h-2.5 w-2.5 shrink-0 rounded-full bg-danger"></span><span>Recording</span><span id="recTime" class="font-mono" aria-hidden="true">00:00</span></p>
            <div class="flex flex-col gap-2 sm:flex-row">
              <button id="recStop" type="button" class="btn btn-primary"><i data-lucide="square" class="h-4 w-4"></i>Stop and save</button>
              <button id="recDiscard" type="button" class="btn btn-ghost"><i data-lucide="trash-2" class="h-4 w-4"></i>Discard</button>
            </div>
          </div>
          <p class="mt-2 text-xs text-mute">Speak clearly and close to your microphone. Recording stops automatically after 10 minutes.</p>
        </div>

        <div id="fileCard" class="mt-4 hidden rounded-2xl border border-edge bg-ink/60 p-4">
          <div class="flex min-w-0 items-start gap-3">
            <i data-lucide="file-audio" class="mt-0.5 h-6 w-6 shrink-0 text-mint"></i>
            <div class="min-w-0"><p id="fileName" class="break-all font-medium"></p><p id="fileMeta" class="mono-tag mt-0.5 text-mute"></p></div>
          </div>
          <audio id="player" controls preload="metadata" class="mt-3 w-full max-w-full"></audio>
          <div class="mt-3 flex flex-col gap-2 sm:flex-row">
            <button id="replaceFile" type="button" class="btn btn-ghost"><i data-lucide="refresh-cw" class="h-4 w-4"></i>Replace recording</button>
            <button id="removeFile" type="button" class="btn btn-ghost"><i data-lucide="trash-2" class="h-4 w-4"></i>Remove recording</button>
          </div>
        </div>
        <p class="mt-3 flex items-start gap-2.5 rounded-xl border border-edge bg-ink/60 p-3 text-xs text-mute"><i data-lucide="info" class="mt-0.5 h-4 w-4 shrink-0 text-sky2"></i><span>The recording (uploaded or recorded live) is sent to Groq for transcription and is not stored by this page. Live recordings use your browser’s audio format (WebM, Ogg or M4A), not MP3. Speech recognition can mishear words, names, numbers, amounts, and accents, so check the transcript. Do not submit calls that contain secrets.</span></p>
      </div>

      <p id="formErr" class="mt-4 hidden rounded-xl border border-danger/40 bg-danger/10 p-3 text-sm text-danger" role="alert"></p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <button id="submitBtn" type="button" class="btn btn-primary sm:min-w-[190px]" disabled><i data-lucide="scan-search" class="h-4 w-4"></i><span>Analyze Message</span></button>
        <button id="resetBtn" type="button" class="btn btn-ghost"><i data-lucide="rotate-ccw" class="h-4 w-4"></i>Reset</button>
        <button id="micBtn" type="button" class="btn btn-ghost hidden" aria-pressed="false" aria-label="Record live voice"><i data-lucide="mic" class="h-4 w-4"></i><span>Record live</span></button>
      </div>
    </section>

    <!-- Card 2: Results -->
    <section class="card p-5 sm:p-6" aria-labelledby="resultsTitle">
