<style>
  html { -webkit-text-size-adjust: 100%; }
  body { background: #080D18; color: #F4F7FB; overflow-x: hidden; }
  .bg-deco {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(900px 500px at 85% -10%, rgba(53,200,255,.13), transparent 60%),
      radial-gradient(700px 500px at -10% 15%, rgba(0,229,168,.10), transparent 60%),
      linear-gradient(rgba(41,54,74,.28) 1px, transparent 1px) 0 0 / 44px 44px,
      linear-gradient(90deg, rgba(41,54,74,.28) 1px, transparent 1px) 0 0 / 44px 44px,
      #080D18;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, rgba(0,0,0,.35));
            mask-image: linear-gradient(to bottom, #000 55%, rgba(0,0,0,.35));
  }
  :focus-visible { outline: 2px solid #35C8FF; outline-offset: 2px; border-radius: 6px; }
  .card { background: rgba(21,31,48,.85); border: 1px solid #29364A; border-radius: 16px; }
  .btn { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
         border-radius: 12px; padding: .6rem 1.1rem; font-weight: 600; font-size: .95rem; transition: background .15s, border-color .15s, opacity .15s; }
  .btn-primary { background: #00E5A8; color: #04130E; }
  .btn-primary:hover:not(:disabled) { background: #33efbb; }
  .btn-ghost { border: 1px solid #29364A; color: #F4F7FB; background: rgba(16,24,39,.7); }
  .btn-ghost:hover:not(:disabled) { border-color: #35C8FF; }
  .btn:disabled { opacity: .45; cursor: not-allowed; }
  .field { width: 100%; background: #0B1322; border: 1px solid #29364A; border-radius: 12px; padding: .7rem .9rem; color: #F4F7FB; font-size: .95rem; }
  .field::placeholder { color: #70809a; }
  .field:focus { border-color: #35C8FF; outline: none; box-shadow: 0 0 0 3px rgba(53,200,255,.2); }
  .mono-tag { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .72rem; letter-spacing: .02em; }
  details > summary { list-style: none; cursor: pointer; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] .chev { transform: rotate(180deg); }
  .chev { transition: transform .2s; }
  .scanline { position: absolute; left: 0; right: 0; top: 0; height: 2px; pointer-events: none;
              background: linear-gradient(90deg, transparent, #35C8FF, transparent); opacity: .75;
              animation: scan 3.8s linear infinite; }
  @keyframes scan { 0% { transform: translateY(0); } 100% { transform: translateY(var(--h, 360px)); } }
  .pulse-dot { animation: pulse 1.8s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
  .spin { animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto !important; }
    .scanline { display: none; }
    .pulse-dot, .spin, .chev { animation: none !important; transition: none !important; }
  }
  .sr-only-live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  section[id], div[id="analyze"] { scroll-margin-top: 84px; }
</style>
</head>

