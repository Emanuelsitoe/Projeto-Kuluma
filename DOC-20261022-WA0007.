  mb.addEventListener('click', () => toggleMenu(mm.classList.contains('hidden')));
  $$('a', mm).forEach(a => a.addEventListener('click', () => toggleMenu(false)));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !mm.classList.contains('hidden')) { toggleMenu(false); mb.focus(); } });
  matchMedia('(min-width: 768px)').addEventListener('change', e => { if (e.matches) toggleMenu(false); });

  checkConnection();

  // modes
  $('#tabText').addEventListener('click', () => setMode('text'));
  $('#tabAudio').addEventListener('click', () => setMode('audio'));
  $$('[role=tab]').forEach(t => t.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); setMode(state.mode === 'text' ? 'audio' : 'text', true); }
  }));

  // text
  $('#msg').addEventListener('input', updateTextUI);
  $('#clearText').addEventListener('click', () => { $('#msg').value = ''; updateTextUI(); $('#msg').focus(); });

  // audio
  const dz = $('#dropZone'), fi = $('#fileInput');
  dz.addEventListener('click', () => fi.click());
  $('#replaceFile').addEventListener('click', () => fi.click());
  $('#removeFile').addEventListener('click', removeFile);
  fi.addEventListener('change', () => { const f = fi.files && fi.files[0]; fi.value = ''; acceptFile(f); });
  ['dragenter', 'dragover'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add('border-mint', 'bg-mint/5'); }));
  ['dragleave', 'drop'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove('border-mint', 'bg-mint/5'); }));
  dz.addEventListener('drop', e => {
    const files = e.dataTransfer && e.dataTransfer.files;
    if (files && files.length) { acceptFile(files[0]); if (files.length > 1) announce('Only the first file was used.'); }
  });
  window.addEventListener('dragover', e => e.preventDefault());
  window.addEventListener('drop', e => e.preventDefault());
  window.addEventListener('pagehide', revokeUrl);

  // actions
  $('#submitBtn').addEventListener('click', onSubmit);
  $('#resetBtn').addEventListener('click', onReset);
  $('#micBtn').addEventListener('click', () => (state.recording ? stopRecording(false) : startRecording()));
  $('#recStop').addEventListener('click', () => stopRecording(false));
  $('#recDiscard').addEventListener('click', () => stopRecording(true));
  window.addEventListener('pagehide', cancelRecording);

  setMode('text'); updateTextUI(); renderInitial(); initContact();
}
document.addEventListener('DOMContentLoaded', () => { init(); window.addEventListener('load', icons); });
</script>
</body>
</html>
