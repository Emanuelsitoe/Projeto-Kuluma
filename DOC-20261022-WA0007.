/* =====================================================================
   SUBMIT / CANCEL / RESET
   ===================================================================== */
function abortAll() { if (state.controller) state.controller.abort(); if (state.xhr) { try { state.xhr.abort(); } catch (e) {} } }
function cancelWork() { if (!state.busy) return; state.cancelled = true; abortAll(); }
function setBusy(b) {
  state.busy = b;
  ['msg', 'clearText', 'dropZone', 'replaceFile', 'removeFile', 'tabText', 'tabAudio', 'micBtn'].forEach(id => { const el = $('#' + id); if (el) el.disabled = b; });
  $('#msg').readOnly = b;
  $('#submitBtn').querySelector('span').textContent = b ? 'Analyzing…' : 'Analyze Message';
  $('#submitBtn').setAttribute('aria-busy', String(b));
  updateSubmit();
}

async function onSubmit() {
  if (state.busy) return;                                    // prevent duplicate requests
  clearFormError();
  if (!hasKey()) { renderError('NO_KEY', false); showFormError('The Groq API key is missing in index.html (CFG.API_KEY).'); return; }
  const key = CFG.API_KEY;

  let content, mode = state.mode;
  if (mode === 'text') {
    const err = textValidation(); if (err) { showFormError(err); return; }
    content = $('#msg').value;
  } else if (!state.file) { showFormError('Choose an MP3 recording first.'); return; }

  const requestId = crypto.randomUUID();
  state.controller = new AbortController(); state.xhr = null; state.timedOut = false; state.cancelled = false;
  state.proc = { requestId, idx: 0, pct: null, stages: mode === 'text' ? ['Analyzing message', 'Preparing results'] : ['Uploading recording', 'Transcribing audio', 'Analyzing transcript', 'Preparing results'] };
  const timer = setTimeout(() => { state.timedOut = true; abortAll(); }, CFG.REQUEST_TIMEOUT_MS);
  setBusy(true);
  if (mode === 'audio') state.proc.pct = 0;
  renderProcessing(); announce(state.proc.stages[0]);
  let m = null;

  try {
    m = await loadModels();
    if (!m.chat || (mode === 'audio' && !m.stt)) throw new AppError('MODEL_UNAVAILABLE');
    let transcript = null;
    if (mode === 'audio') {
      transcript = await transcribe(state.file, key, m.stt,
        pct => { state.proc.pct = pct; renderProcessing(); },
        () => setStage(1));                                  // upload really finished → transcription stage starts
      content = transcript;
      setStage(2);                                           // transcription really finished
    }
    const analysis = await analyze(content, key, m.chat);
    setStage(state.proc.stages.length - 1);
    state.lastResult = analysis;
    renderResult(analysis, { mode, original: content });
    announce('Analysis complete. Risk level: ' + RISK[analysis.riskLevel].label);
    $('#resultsTitle').focus({ preventScroll: true });
    $('#resultsTitle').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  } catch (e) {
    let code = e instanceof AppError ? e.code : (e instanceof TypeError || (e && e.name === 'TimeoutError')) ? 'NETWORK' : 'ANALYSIS_FAILED';
    if (state.cancelled) code = 'CANCELLED'; else if (state.timedOut) code = 'TIMEOUT';
    renderError(code, true);
    if (code === 'KEY_REJECTED') setStatus('bad');
  } finally {
    clearTimeout(timer); state.xhr = null; setBusy(false);   // input is preserved so the user can retry
  }
}

function onReset() {
  cancelRecording();
  if (state.busy) { state.cancelled = true; abortAll(); }
  $('#msg').value = ''; updateTextUI();
  removeFile(); clearFormError();
  state.lastResult = null; state.proc = null;
  renderInitial(); announce('Workspace reset.');
}

/* =====================================================================
   LIVE RECORDING (microphone → MediaRecorder → same upload flow)
   ===================================================================== */
const MAX_RECORD_SEC = 600;
const REC_TYPES = [['audio/webm;codecs=opus', 'webm'], ['audio/webm', 'webm'], ['audio/ogg;codecs=opus', 'ogg'], ['audio/mp4', 'm4a']];
const fmtClock = sec => String(Math.floor(sec / 60)).padStart(2, '0') + ':' + String(sec % 60).padStart(2, '0');
function showRecError(t) { showFileError(t); announce(t); }
function setMicBtn(rec) {
  const b = $('#micBtn');
  b.setAttribute('aria-pressed', String(rec));
  b.setAttribute('aria-label', rec ? 'Stop recording' : 'Record live voice');
  b.classList.toggle('!border-danger', rec); b.classList.toggle('text-danger', rec);
  b.innerHTML = '<i data-lucide="' + (rec ? 'square' : 'mic') + '" class="h-4 w-4"></i><span>' + (rec ? 'Stop recording' : 'Record live') + '</span>';
  icons();
}
function lockForRecording(on) {
  ['tabText', 'tabAudio', 'dropZone', 'replaceFile', 'removeFile'].forEach(id => { const el = $('#' + id); if (el) el.disabled = on; });
}
async function startRecording() {
  if (state.busy || state.recording) return;
  showFileError(''); clearFormError();
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || !window.MediaRecorder)
    return showRecError('Live recording is not supported in this browser or page. Upload an MP3 instead.');
  let stream;
  try { stream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
  catch (e) {
    return showRecError(e && e.name === 'NotAllowedError' ? 'Microphone access was blocked. Allow it from the browser address bar, then try again.'
      : e && e.name === 'NotFoundError' ? 'No microphone was found on this device.' : 'The microphone could not be started.');
  }
  const type = REC_TYPES.find(([t]) => MediaRecorder.isTypeSupported(t)) || null;
  let recorder;
  try { recorder = type ? new MediaRecorder(stream, { mimeType: type[0] }) : new MediaRecorder(stream); }
  catch (e) { stream.getTracks().forEach(t => t.stop()); return showRecError('Live recording is not supported in this browser. Upload an MP3 instead.'); }
  const mt = recorder.mimeType || '';
  const rec = { recorder, stream, chunks: [], bytes: 0, discard: false, done: false, started: Date.now(), timer: null,
                ext: type ? type[1] : mt.includes('mp4') ? 'm4a' : mt.includes('ogg') ? 'ogg' : 'webm' };
  state.rec = rec; state.recording = true;
  recorder.ondataavailable = e => {
    if (!e.data || !e.data.size) return;
    rec.chunks.push(e.data); rec.bytes += e.data.size;
    if (rec.bytes > MAX_AUDIO_BYTES) stopRecording(false);       // never exceed the upload limit
  };
  recorder.onstop = () => finishRecording(rec);
  recorder.onerror = () => { stopRecording(true); showRecError('Recording failed. Please try again.'); };
  recorder.start(1000);
  lockForRecording(true); setMicBtn(true); updateSubmit();
  $('#recTime').textContent = '00:00'; $('#recPanel').classList.remove('hidden');
  rec.timer = setInterval(() => {
    const sec = Math.floor((Date.now() - rec.started) / 1000);
    $('#recTime').textContent = fmtClock(sec);
    if (sec >= MAX_RECORD_SEC) stopRecording(false);
  }, 500);
  announce('Recording started.');
}
function stopRecording(discard) {
  const rec = state.rec; if (!rec) return;
  rec.discard = !!discard;
  try { if (rec.recorder.state !== 'inactive') rec.recorder.stop(); else finishRecording(rec); }
  catch (e) { finishRecording(rec); }
}
function cancelRecording() { if (state.recording) stopRecording(true); }
function finishRecording(rec) {
  if (rec.done) return; rec.done = true;
  clearInterval(rec.timer);
  rec.stream.getTracks().forEach(t => t.stop());                 // turns the microphone indicator off
  state.rec = null; state.recording = false;
  $('#recPanel').classList.add('hidden'); setMicBtn(false); lockForRecording(false);
  const secs = Math.round((Date.now() - rec.started) / 1000);
  if (rec.discard) { announce('Recording discarded.'); updateSubmit(); return; }
  const blob = new Blob(rec.chunks, { type: rec.recorder.mimeType || 'audio/webm' });
  if (blob.size < 2000 || secs < 1) { showRecError('That recording was too short. Try again and speak for a few seconds.'); updateSubmit(); return; }
  if (blob.size > MAX_AUDIO_BYTES) { showRecError('That recording is larger than the ' + CFG.MAX_AUDIO_MB + ' MB limit. Record a shorter clip.'); updateSubmit(); return; }
  const file = new File([blob], 'live-recording.' + rec.ext, { type: blob.type });
  setFile(file, 'Live recording · ' + rec.ext.toUpperCase(), rec.ext, 'Live recording (' + fmtClock(secs) + ')');
  announce('Recording saved. Press Analyze Message to continue.');
}

