  medium:       { label: 'Medium',       icon: 'triangle-alert', cls: 'text-warn border-warn/40 bg-warn/10',       def: 'Some suspicious indicators are present and deserve further verification.' },
  high:         { label: 'High',         icon: 'octagon-alert', cls: 'text-danger border-danger/40 bg-danger/10', def: 'Multiple or significant warning signs suggest a substantial risk.' },
  critical:     { label: 'Critical',     icon: 'siren',         cls: 'text-danger border-danger bg-danger/20',    def: 'The available content contains severe indicators, such as an explicit coercive demand for money or credentials combined with credible threats or impersonation signals.' },
  inconclusive: { label: 'Inconclusive', icon: 'circle-help',   cls: 'text-mute border-edge bg-surf',             def: 'The content is insufficient, unclear, contradictory, or could not be analyzed reliably.' }
